# Salin file ini menjadi .env dan lengkapi nilainya:
# cp .env.example .env

# Port Server Backend API
PORT=3001

# Rahasia Token JWT Otentikasi
JWT_SECRET=ganti_dengan_kunci_rahasia_jwt_anda_2026

# String Koneksi Database Cloud Serverless Neon PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=postgresql://neondb_owner:PASSWORD_ANDA@ep-sample-b4onkhk7-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require
